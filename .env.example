PORT=3000

# Destinatário dos leads
MAIL_TO=contato@vestidasdebranco.com.br
# Remetente verificado no SendGrid (mesmo do backend)
MAIL_FROM=contato@vestidasdebranco.com.br

# SendGrid — mesma chave do backend-vestidas-de-branco
SENDGRID_API_KEY=

# PDF no Google Drive — cole a URL completa ou só o ID do arquivo
GOOGLE_DRIVE_URL=https://drive.google.com/file/d/1Rr2iKHra47YXJQxBK7uSLjN9SUyQaSn9/view
GOOGLE_DRIVE_FILE_ID=1Rr2iKHra47YXJQxBK7uSLjN9SUyQaSn9

# Opcional: se preferir hospedar o PDF no servidor, coloque em public/assets/guia.pdf
# e deixe GOOGLE_DRIVE_* vazio. O arquivo local tem prioridade.
PDF_FILENAME=guia-completo-vestidas-de-branco.pdf
